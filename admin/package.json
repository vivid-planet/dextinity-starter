{
    "name": "starter-admin",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "admin-generator": "rimraf --glob 'src/**/generated' && dextinity-admin-generator generate && npm run gql:types",
        "build": "run-s admin-generator intl:compile && run-p gql:types generate-block-types && NODE_ENV=production vite build",
        "check-node-version": "check-node-version --node $(cat ../.nvmrc)",
        "generate-block-types": "dextinity generate-block-types --inputs",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"npm run generate-block-types\"",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "postinstall": "cd server && npm install",
        "intl:compile": "run-p intl:compile:starter-admin intl:compile:dextinity",
        "intl:compile:dextinity": "formatjs compile-folder --format simple --ast lang/dextinity-lang lang-compiled/dextinity-lang",
        "intl:compile:starter-admin": "formatjs compile-folder --format simple --ast lang/starter-lang/admin lang-compiled/starter-admin",
        "intl:extract": "formatjs extract \"src/**/*.ts*\" --ignore ./**.d.ts --out-file lang-extracted/en.json --format simple --throws",
        "prelint": "npm run intl:compile && run-p gql:types generate-block-types",
        "lint": "npm run admin-generator && run-p -l lint:{eslint,knip,prettier,tsc} intl:extract",
        "lint:ci": "npm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:{eslint,prettier}",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npm run lint:prettier -- --write",
        "lint:knip": "knip --exports --files --dependencies --tags=-knipignore",
        "lint:prettier": "npx prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --project .",
        "preview": "npm run build && vite preview",
        "serve": "node server",
        "setup:ci": "./intl-update.sh",
        "start": "npm run check-node-version && run-s admin-generator intl:compile && run-p gql:types generate-block-types && dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- vite"
    },
    "overrides": {
        "react-final-form": {
            "react": "^19.2.4"
        },
        "react-final-form-arrays": {
            "react": "^19.2.4"
        }
    },
    "dependencies": {
        "@apollo/client": "^3.14.1",
        "@dextinity/admin": "10.1.0",
        "@dextinity/admin-icons": "10.1.0",
        "@dextinity/cms-admin": "10.1.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource-variable/roboto-flex": "^5.3.0",
        "@mui/material": "^7.3.11",
        "@mui/x-data-grid": "^8.29.3",
        "@mui/x-data-grid-pro": "^8.29.3",
        "@mui/x-date-pickers": "^8.29.3",
        "change-case": "^5.4.4",
        "date-fns": "^4.4.0",
        "final-form": "^4.20.10",
        "graphql": "^16.14.2",
        "history": "^4.10.1",
        "lodash.isequal": "^4.5.0",
        "rdndmb-html5-to-touch": "^9.0.0",
        "react": "^19.2.8",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-dnd-multi-backend": "^9.0.0",
        "react-dom": "^19.2.8",
        "react-final-form": "^6.5.9",
        "react-intl": "^7.1.14",
        "react-router": "^5.3.4",
        "react-router-dom": "^5.3.4"
    },
    "devDependencies": {
        "@dextinity/admin-generator": "10.1.0",
        "@dextinity/cli": "10.1.0",
        "@dextinity/eslint-config": "10.1.0",
        "@formatjs/cli": "^6.16.20",
        "@graphql-codegen/add": "^7.1.0",
        "@graphql-codegen/cli": "^7.3.1",
        "@graphql-codegen/fragment-matcher": "^7.1.0",
        "@graphql-codegen/introspection": "^6.1.0",
        "@graphql-codegen/named-operations-object": "^4.0.1",
        "@graphql-codegen/near-operation-file-preset": "^5.2.2",
        "@graphql-codegen/typescript": "^6.1.0",
        "@graphql-codegen/typescript-operations": "^6.1.6",
        "@parcel/watcher": "^2.6.0",
        "@swc/plugin-emotion": "^14.19.0",
        "@types/lodash.isequal": "^4.5.8",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@types/react-router": "^5.1.20",
        "@types/react-router-dom": "^5.3.3",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.5",
        "knip": "^6.32.2",
        "npm-run-all2": "^9.0.3",
        "prettier": "^3.9.6",
        "rimraf": "^6.1.3",
        "typescript": "^5.9.3",
        "vite": "^8.2.2",
        "vite-plugin-compression2": "^2.5.3",
        "vite-plugin-html": "^3.2.2"
    },
    "engines": {
        "node": "24"
    }
}
