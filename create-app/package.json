{
    "name": "@dextinity/create-app",
    "version": "1.221.0",
    "description": "Command-line interface to create a new Dextinity application",
    "homepage": "https://github.com/vivid-planet/dextinity-starter/tree/main/create-app#readme",
    "bugs": {
        "url": "https://github.com/vivid-planet/dextinity-starter/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/vivid-planet/dextinity-starter",
        "directory": "create-app"
    },
    "license": "BSD-2-Clause",
    "author": "Vivid Planet Software GmbH <office@vivid-planet.com> (https://www.vivid-planet.com/)",
    "bin": "./bin/index.js",
    "sideEffects": false,
    "files": [
        "lib/**/*.js"
    ],
    "scripts": {
        "prebuild": "npm run clean",
        "build": "tsc --project tsconfig.json",
        "clean": "rimraf lib",
        "lint": "run-p -l lint:{eslint,knip,prettier,tsc}",
        "lint:eslint": "eslint --max-warnings 0 src/ '**/*.json' --no-warn-ignored",
        "lint:knip": "knip --exports --files --dependencies --tags=-knipignore",
        "lint:prettier": "npx prettier --check '*.{ts,js,json,md,yml,yaml}'",
        "lint:tsc": "tsc --project ./tsconfig.json",
        "prepublishOnly": "npm run lint && npm run build",
        "prestart": "npm run clean",
        "start": "tsc --watch --project tsconfig.json"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "eslint": "^9.39.5",
        "glob": "^13.0.6",
        "kleur": "^4.1.5",
        "nanospinner": "^1.2.2",
        "rimraf": "^6.1.3"
    },
    "devDependencies": {
        "@dextinity/eslint-config": "10.1.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^24.13.3",
        "knip": "^6.32.2",
        "npm-run-all2": "^9.0.2",
        "prettier": "^3.9.4",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": "24"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    }
}
