{
    "name": "starter-site",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run intl:compile && run-p gql:types generate-block-types css:types && next build --webpack",
        "build-storybook": "storybook build --disable-telemetry",
        "check-node-version": "check-node-version --node $(cat ../.nvmrc)",
        "css:types": "typed-scss-modules src --nameFormat none --exportType default --aliasPrefixes.@src src",
        "css:types:watch": "npm run css:types -- --watch",
        "dev": "npm run check-node-version && npm run intl:compile && run-s gql:types generate-block-types && dotenv -e .env.secrets -e .env.local -e .env -e .env.site-configs -- node --inspect=localhost:9230 --max-old-space-size=512 server.ts",
        "generate-block-types": "dextinity generate-block-types",
        "generate-block-types:watch": "chokidar -s \"block-meta.json\" -c \"npm run generate-block-types\"",
        "gql:types": "graphql-codegen",
        "gql:watch": "graphql-codegen --watch",
        "intl:compile": "formatjs compile-folder --format simple --ast lang/starter-lang/site lang-compiled/",
        "intl:extract": "formatjs extract \"src/**/*.ts*\" --ignore \"src/**/*.d.ts\" --out-file lang-extracted/en.json --format simple --throws",
        "prelint": "npm run intl:compile && run-p gql:types generate-block-types css:types",
        "lint": "run-p -l lint:{eslint,knip,prettier,style,tsc} intl:extract",
        "lint:ci": "npm run lint",
        "lint:eslint": "eslint --max-warnings 0 src/ .storybook/ '**/*.json' --no-warn-ignored",
        "lint:fix": "run-p lint:fix:{eslint,prettier,style}",
        "lint:fix:eslint": "npm run lint:eslint -- --fix",
        "lint:fix:prettier": "npm run lint:prettier -- --write",
        "lint:fix:style": "npm run lint:style -- --fix",
        "lint:knip": "knip --exports --files --dependencies --tags=-knipignore",
        "lint:prettier": "npx prettier --check '*.{ts,js,json,md,yml,yaml,css,scss}'",
        "lint:style": "npx stylelint '**/*.{css,scss}'",
        "lint:tsc": "npx next typegen && tsc --project . && tsc --project tsconfig.server.json && tsc --project tsconfig.storybook.json",
        "serve": "NODE_ENV=production node server.ts",
        "setup:ci": "./intl-update.sh",
        "storybook": "storybook dev -p 26648 --no-open --disable-telemetry",
        "test": "npm run test:unit && npm run test:storybook",
        "test:ci": "npm run test",
        "test:storybook": "vitest --run --project storybook --outputFile.junit=./junit-storybook.xml",
        "test:unit": "vitest --run --project unit --outputFile.junit=./junit.xml",
        "test:watch": "vitest --watch"
    },
    "dependencies": {
        "@dextinity/site-nextjs": "10.15.0",
        "@fontsource/roboto": "^5.3.0",
        "@next/bundle-analyzer": "^16.4.6",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/auto-instrumentations-node": "^0.83.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.301.0",
        "@opentelemetry/sdk-node": "^0.301.0",
        "cache-manager": "^7.2.9",
        "clsx": "^2.1.1",
        "embla-carousel": "9.0.0-rc04",
        "embla-carousel-accessibility": "9.0.0-rc04",
        "embla-carousel-auto-height": "9.0.0-rc04",
        "embla-carousel-react": "9.0.0-rc04",
        "graphql": "^16.15.0",
        "ioredis": "^6.0.0",
        "lru-cache": "^11.5.3",
        "next": "^16.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-focus-lock": "^2.13.7",
        "react-intl": "^7.1.14",
        "redraft": "^0.10.2",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@dextinity/cli": "10.15.0",
        "@dextinity/eslint-config": "10.15.0",
        "@formatjs/cli": "^6.18.2",
        "@graphql-codegen/add": "^8.0.0",
        "@graphql-codegen/cli": "^8.0.0",
        "@graphql-codegen/named-operations-object": "^4.0.1",
        "@graphql-codegen/near-operation-file-preset": "^5.2.4",
        "@graphql-codegen/typescript": "^7.0.1",
        "@graphql-codegen/typescript-operations": "^7.0.1",
        "@parcel/watcher": "^2.6.0",
        "@storybook/addon-a11y": "10.6.7",
        "@storybook/addon-docs": "^10.6.7",
        "@storybook/addon-vitest": "10.6.7",
        "@storybook/nextjs-vite": "10.6.7",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/browser-playwright": "5.1.0",
        "check-node-version": "^4.2.1",
        "chokidar-cli": "^3.0.0",
        "dotenv-cli": "^11.1.0",
        "eslint": "^9.39.5",
        "eslint-plugin-storybook": "^10.6.7",
        "jsdom": "^31.0.0",
        "knip": "^6.44.2",
        "npm-run-all2": "^9.0.4",
        "playwright": "^1.65.0",
        "prettier": "^3.9.10",
        "sass": "^1.108.1",
        "schema-dts": "^2.1.0",
        "storybook": "^10.6.7",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "typed-scss-modules": "^8.1.1",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": "24"
    }
}
