# Build context for the docker preview environment (see docker-compose.preview.yml).
# Everything that is generated during install/build is excluded, so that a build
# from a fresh clone and a build from a local working copy produce the same image.

.git
**/node_modules

# Local env files - the preview environment gets its config from docker-compose.preview.yml
# (.env.site-configs.tpl is needed and deliberately not listed here)
.env
.env.local
.env.secrets
.env.site-configs
.env.site-configs.preview
**/.env
**/.env.local
**/.env.secrets
**/.env.site-configs

# Build output
**/dist
**/.next
**/.swc
**/coverage
admin/build
api/uploads

# Downloaded at build time by intl-update.sh
**/lang
**/lang-compiled
**/lang-extracted

# Generated by setup-project-files.js - the Dockerfile copies these explicitly
admin/schema.gql
admin/schema.json
admin/block-meta.json
admin/fragmentTypes.json
admin/src/dextinity-config.json
admin/src/site-configs.d.ts
api/src/site-configs.d.ts
site/schema.gql
site/block-meta.json
site/src/dextinity-config.json
site/src/site-configs.d.ts

# Generated by the code generators / build
**/*.generated.ts
**/src/**/generated
site/src/**/*.scss.d.ts
site/next-env.d.ts
site/public/robots.txt
site/public/sitemap.xml
api/src/.nestjs_repl_history

# Not needed to build or run the application
.agents
.claude
.cursor
.digitalocean
.docker-compose
.github
.husky
.vscode
create-app
**/*.md
