# Build context for the deploy preview environment (see .deploy-preview/docker-compose.yml).
# Everything that is generated during install/build is excluded, so that a build from a fresh
# clone and a build from a local working copy produce the same image.

**/node_modules

# Local env files - the preview environment gets its config from .deploy-preview/docker-compose.yml
**/.env
**/.env.local
**/.env.secrets
**/.env.site-configs
**/.env.site-configs.deploy-preview

# Build output
**/dist
**/.next
**/.swc
**/coverage
**/*.tsbuildinfo
admin/build
api/uploads

# Downloaded at build time by intl-update.sh
**/lang
**/lang-compiled
**/lang-extracted

# Generated by setup-project-files.js - the Dockerfiles copy the originals explicitly
admin/.npmrc
admin/schema.gql
admin/schema.json
admin/fragmentTypes.json
admin/block-meta.json
admin/src/dextinity-config.json
admin/src/site-configs.d.ts
api/.npmrc
api/src/site-configs.d.ts
site/.npmrc
site/schema.gql
site/schema.json
site/block-meta.json
site/src/dextinity-config.json
site/src/site-configs.d.ts

# Generated by the code generators / build
**/*.generated.ts
api/src/**/generated
api/src/.nestjs_repl_history
site/next-env.d.ts
site/src/**/*.scss.d.ts
site/public/robots.txt
site/public/sitemap.xml

# Not needed in any image
create-app
.git
.github
.husky
.vscode
.idea
.docker-compose
.digitalocean

# Documentation - excluded so that editing it does not invalidate the build cache
**/*.md
